# Backend environment variables. Copy this file to `.env` and fill in values.

# PostgreSQL database connection string.
# Host port defaults to 5433 so it coexists with local dev setups that already
# use 5432 (e.g. an existing Postgres service or another compose project).
DATABASE_URL="postgresql://erp:erp_password@localhost:5433/erp_crm?schema=public"

# JWT signing secret - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000

# Comma separated list of allowed CORS origins for the browser frontend
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"